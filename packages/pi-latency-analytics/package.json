{
  "name": "pi-latency-analytics",
  "version": "0.1.0",
  "description": "Standalone, privacy-conscious Pi latency tracing with a background SQLite writer",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/rcsaquino/pi-extensions.git", "directory": "packages/pi-latency-analytics" },
  "homepage": "https://github.com/rcsaquino/pi-extensions/tree/main/packages/pi-latency-analytics#readme",
  "bugs": { "url": "https://github.com/rcsaquino/pi-extensions/issues" },
  "publishConfig": { "access": "public" },
  "keywords": ["pi-package", "pi-extension", "analytics", "latency", "sqlite"],
  "files": ["index.ts", "lib", "README.md", "AGENTS.md", "LICENSE"],
  "pi": { "extensions": ["./index.ts"] },
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "bench": "node scripts/benchmark.mjs",
    "verify": "npm run check && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@earendil-works/pi-ai": "0.99.2",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
