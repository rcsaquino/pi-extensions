# Copy to a PRIVATE environment file; never commit filled-in values.
# Chat requires a real bot token and an explicit private-user allowlist.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_ID=
# Required only when TELEGRAM_ALLOWED_ID lists more than one user.
TELEGRAM_DESTINATION_ID=

# Optional incoming voice/audio transcription. A Pi /login groq key is used only as a fallback.
GROQ_API_KEY=

# Optional explicitly requested speech. Use your exact configured voice/model.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v4
